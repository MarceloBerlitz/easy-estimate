{
  "compilerOptions": {
    "module": "CommonJS",
    "noImplicitAny": true,
    "target": "es2017",
    "removeComments": true,
    "preserveConstEnums": true,
    "esModuleInterop": true,
    "outDir": "dist",
    "declaration": true,
    "sourceMap": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "**/*.spec.ts"]
}
