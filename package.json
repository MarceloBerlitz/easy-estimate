{
  "name": "easy-estimate",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "yarn workspace @ee/server start & yarn workspace @ee/web start",
    "prebuild": "yarn clean",
    "build": "yarn lib:build && yarn web:build && yarn server:build",
    "postbuild": "yarn moveweb",
    "clean": "yarn lib:clean & yarn web:clean & yarn server:clean",
    "lib:build": "yarn workspace @ee/lib build",
    "lib:clean": "yarn workspace @ee/lib clean",
    "web:build": "yarn workspace @ee/web build",
    "web:clean": "yarn workspace @ee/web clean",
    "server:build": "yarn workspace @ee/server build",
    "server:clean": "yarn workspace @ee/server clean",
    "premoveweb": "mkdir -p ./packages/server/dist/public/",
    "moveweb": "mv ./packages/web/build/* ./packages/server/dist/public/.",
    "test": "echo 'not implemented'"
  },
  "workspaces": {
    "packages": [
      "packages/*"
    ]
  }
}
